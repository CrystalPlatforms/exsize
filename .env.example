# ExSize backend environment variables.
# Copy this file to `.env` (gitignored) and fill in real values.
# NEVER commit real secrets. On Render, set these in the dashboard.

# --- Database ---
# SQLite locally, Neon Postgres in production.
DATABASE_URL=sqlite:///exsize.db

# --- App ---
# Comma-separated list of allowed origins. Use "*" only for local dev.
CORS_ORIGINS=http://localhost:5173
PORT=8000

# --- Auth ---
# MUST be a random string in production (the code fallback is weak/dev-only).
SECRET_KEY=dev-secret-key-change-in-production
# Absent = admin login disabled. Set to a strong secret to allow /api/auth/admin-login.
ADMIN_SECRET=

# --- Push notifications (ExSize 2.0, issue #64) ---
# VAPID keypair for web push. Generate once with:
#   npx web-push generate-vapid-keys
# (outputs a public + private key in base64url — store both as-is).
# Phase 5 only needs VAPID_PUBLIC_KEY (the browser needs it to subscribe).
# Phase 6 (#65) sending also needs VAPID_PRIVATE_KEY + VAPID_SUBJECT.
# Leave all three blank to disable push gracefully (no error, UI hides the toggle).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
